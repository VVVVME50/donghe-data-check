# Server-side only. Full HTTPS chat/completions endpoint, never a browser key.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# schema (strict JSON schema) or object (legacy JSON mode)
AI_JSON_MODE=schema
AI_PROVIDER=
# Explicitly permit materials-only screening while regulations remain unverified.
AI_ALLOW_MATERIAL_SCREENING=false
# Comma-separated frontend origins, no wildcard.
AI_ALLOWED_ORIGINS=

# Optional public backend base URL for the GitHub Pages frontend. Never put a key here.
# The backend must allow the Pages origin in its CORS policy.
VITE_AI_API_BASE_URL=
